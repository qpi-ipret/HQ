<style>
  :root{
    --bg:#000; --red:#ff2b2b; --text:#e6e6e6;
    --glow:0 0 .6rem #ff2b2b, 0 0 1.2rem #ff2b2b, 0 0 2.2rem rgba(255,43,43,.6);
  }
  html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:ui-monospace,Consolas,Menlo,Monaco,monospace;overflow:hidden}
  .app{display:grid;grid-template-columns:290px 1fr;height:100%}

  /* Sidebar */
  .side{background:linear-gradient(180deg,#050505,#0d0d0d);border-right:2px solid rgba(255,43,43,.25);padding:14px 12px 80px;position:relative}
  .side h1{color:var(--red);text-shadow:var(--glow);font-size:18px;margin:0 0 8px;letter-spacing:.18em}
  .block{margin-top:10px;padding-top:8px;border-top:1px dashed rgba(255,43,43,.25)}
  .label{font-size:12px;color:#aaa;margin-bottom:6px}
  .regions{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:8px}
  .regions li{border:1px solid rgba(255,43,43,.35);border-radius:10px;padding:10px 12px;cursor:pointer;user-select:none;background:linear-gradient(135deg,rgba(255,0,0,.05),transparent 60%);transition:transform .08s ease,border-color .2s}
  .regions li:hover{transform:translateY(-1px);border-color:var(--red)}
  .regions li.active{border-color:var(--red);box-shadow:inset 0 0 0 2px rgba(255,43,43,.25),var(--glow);color:#fff}
  .filters{display:grid;gap:6px}
  .filter-row{display:flex;align-items:center;gap:8px;font-size:13px}
  .filter-row input{accent-color:#ff2b2b}
  .toggles{display:grid;gap:6px;margin-top:6px}
  .search-wrap{display:flex;gap:6px}
  .search-input{width:100%;padding:8px 10px;border-radius:10px;background:#0a0a0a;color:#fff;border:1px solid rgba(255,43,43,.35);outline:none}
  .search-input:focus{border-color:var(--red);box-shadow:var(--glow)}
  .stat{position:absolute;bottom:10px;left:12px;right:12px;font-size:12px;color:#cfcfcf;opacity:.9}
  .stat .row{display:flex;justify-content:space-between;margin-top:4px}
  .stat b{color:#fff}

  /* Map */
  #map{height:100%;width:100%;position:relative;background:#010101}
  .leaflet-container{background:#010101}
  .attribution{position:absolute;right:8px;bottom:6px;font-size:10px;color:#888;z-index:400;background:rgba(0,0,0,.5);padding:2px 6px;border-radius:6px}

  /* Radar sweep */
  .sweep{position:absolute;inset:0;pointer-events:none;z-index:350;mix-blend-mode:screen;opacity:.35;
    background:radial-gradient(60% 60% at 50% 50%,rgba(255,0,0,.14),transparent 60%),conic-gradient(from 0deg,rgba(255,43,43,.35),rgba(255,43,43,0) 45deg 360deg);
    mask:radial-gradient(circle at 50% 50%,rgba(0,0,0,.9),rgba(0,0,0,.1) 60%,rgba(0,0,0,0) 75%);animation:spin 6s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* Top brand, chip & status */
  .brand-left{position:absolute;top:10px;left:310px;z-index:500;color:#fff;font-weight:800;letter-spacing:.18em;font-size:18px;text-shadow:0 0 .6rem #ff2b2b,0 0 1.2rem #ff2b2b;pointer-events:none}
  .brand-right{position:absolute;top:10px;right:12px;z-index:500;color:#fff;font-weight:800;letter-spacing:.12em;font-size:16px;background:rgba(0,0,0,.45);padding:4px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.25);pointer-events:none}
  .chips{position:absolute;top:40px;left:310px;z-index:500;display:flex;gap:8px}
  .chip{background:rgba(10,10,10,.7);border:1px solid rgba(255,43,43,.35);color:#ddd;padding:4px 8px;border-radius:8px;font-size:11px;backdrop-filter:blur(2px)}
  .blink{animation:blink 1s steps(2,end) infinite}
  @keyframes blink{50%{opacity:.2}}
  .status{position:absolute;top:70px;right:12px;z-index:550;max-width:38ch;font-size:12px;background:rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.25);border-radius:10px;padding:8px 10px;color:#fff}
  .status b{color:#fff}
  .status .err{color:#ff9c9c}
</style>
